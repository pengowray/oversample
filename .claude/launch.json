      "runtimeExecutable": "trunk",
      "runtimeArgs": [
        "serve",
        "--release",
        "--port",
        "21347"
      ],
      "port": 21347
    },
    {
      "name": "trunk-tauri",
      "runtimeExecutable": "trunk",
      "runtimeArgs": [
        "serve",
        "--release",
        "--port",
        "21259"
      ],
      "port": 21259
    },
    {
      "name": "trunk-own-dist",
      "runtimeExecutable": "trunk",
      "runtimeArgs": [
